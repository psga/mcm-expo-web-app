# Copia este archivo a secrets.toml (en la misma carpeta) y completa con
# tus credenciales reales de PostgreSQL. Ver docs/BASE_DE_DATOS.md.
#
#   cp secrets.toml.example secrets.toml
#
# secrets.toml NO se sube al repositorio (está en .gitignore).
[db]
host = "localhost"
port = 5432
dbname = "mcm_expo"
user = "mcm_user"
password = "cambia-esta-contraseña"
